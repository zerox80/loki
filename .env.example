# Configuration only. Keep passwords and private keys out of this file.
# Copy to .env and set the actual WAN interface and private directory.
LOKI_WAN_IFACE=eth0
LOKI_KEYS_DIR=/etc/loki/server-keys
LOKI_UID=1000
LOKI_GID=1000
LOKI_PORT=4433
LOKI_TUN=cvpn0
LOKI_MTU=1280
LOKI_BIND_ADDRESS=0.0.0.0
LOKI_PEER_NAME=client.cvpn
LOKI_IMAGE=loki-vpn:local
